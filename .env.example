# Database Connection (Custom Server or Railway MySQL)
DB_HOST=your-server-ip-or-domain
DB_PORT=3306
DB_USER=accountsakbgroup_user
DB_PASSWORD=your_db_password
DB_NAME=accountsakbgroup_db

# Alternative: Railway Native MySQL URL or variables
# MYSQL_URL=mysql://root:password@host:3306/akb-accounts

# App Settings
PORT=3000
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret-string
ADMIN_EMAIL=admin@akbgroups.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator

